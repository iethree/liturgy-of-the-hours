<!doctype html>
<html lang="en">
  {% include "head.njk" %}
  <body>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme" title="Toggle theme">
      <svg class="theme-toggle__icon theme-toggle__icon--light" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 3v1.5M12 19.5V21M4.22 4.22l1.06 1.06M18.72 18.72l1.06 1.06M3 12h1.5M19.5 12H21M4.22 19.78l1.06-1.06M18.72 5.28l1.06-1.06"/>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--dark" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 14.25A8 8 0 1 1 9.75 3.5a6.5 6.5 0 0 0 10.75 10.75Z"/>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--auto" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"/>
        <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none"/>
      </svg>
      <span id="theme-toggle-label" class="theme-toggle__label">auto</span>
    </button>

    {% block body %}{% endblock %}

    {% block scripts %}{% endblock %}
  </body>
</html>
