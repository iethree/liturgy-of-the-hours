{
  "name": "liturgy-of-the-hours",
  "version": "2.0.0",
  "type": "module",
  "description": "A digital liturgy of the hours: a JSON API + Preact SPA serving short prayer services drawn from the Book of Common Prayer and beyond.",
  "main": "src/prayer-app.ts",
  "scripts": {
    "start": "bun run build-client && bun run pm2:start",
    "dev": "bun run scripts/dev.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun run build-client",
    "build-client": "bun build ./client/app.tsx --outdir ./public/js --target browser --minify --entry-naming '[name].js' --define 'process.env.NODE_ENV=\"production\"'",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.0.4",
    "chalk": "^5.3.0",
    "daily-office-lectionary": "^0.9.0",
    "date-fns": "^4.1.0",
    "express": "^4.21.1",
    "markdown-it": "^14.1.0",
    "morgan": "^1.10.0",
    "preact": "^10.24.0",
    "preact-iso": "^2.9.0",
    "random-seed": "^0.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/markdown-it": "^14.1.2",
    "@types/morgan": "^1.9.9",
    "@types/random-seed": "^0.3.5",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iethree/liturgy-of-the-hours.git"
  },
  "author": "RL",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iethree/liturgy-of-the-hours#readme"
  },
  "homepage": "https://github.com/iethree/liturgy-of-the-hours#readme"
}
